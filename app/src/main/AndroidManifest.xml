<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">     <!-- Si votre API_URL est en HTTP (non HTTPS) et que vous ciblez Android 9 (API 28) ou plus,
             vous pourriez avoir besoin d'autoriser le trafic en clair.
             Préférez HTTPS pour la production. Pour le développement local: -->
        

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- AJOUT: Permissions pour la caméra (requise par BarcodeScanner) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- AJOUT: Permissions pour la géolocalisation (requise par Geolocation) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Optionnel mais recommandé: déclare que l'app utilise le GPS.
         Si votre app peut fonctionner sans GPS, vous pouvez mettre android:required="false"
         Par défaut, c'est true, ce qui peut filtrer votre app sur le Play Store pour les appareils sans GPS.
         Pour un pointage, le GPS est souvent souhaité. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false"/>
</manifest>
